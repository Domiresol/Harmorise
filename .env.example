# ══════════════════════════════════════════════════════════════
# Harmorise — 환경변수 설정 예시
# 이 파일을 복사해서 .env 로 만든 뒤 실제 값을 채워주세요
# cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────
POSTGRES_USER=harmorise
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=harmorise_db

# Docker 환경: @postgres (컨테이너 내부 hostname)
# 로컬 개발:   @localhost
DATABASE_URL="postgresql://harmorise:your-strong-password-here@localhost:5432/harmorise_db"

# ──────────────────────────────────────
# Redis
# ──────────────────────────────────────
# Docker 환경: redis  / 로컬 개발: localhost
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────
# Kafka (Redpanda)
# ──────────────────────────────────────
# Docker 환경: redpanda:9092  / 로컬 개발: localhost:19092
KAFKA_BROKERS=localhost:19092

# ──────────────────────────────────────
# NestJS
# ──────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────
# JWT — 반드시 충분히 긴 랜덤 문자열로 설정
# 생성 예시: openssl rand -hex 64
# ──────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_64
PHONE_TOKEN_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# ──────────────────────────────────────
# SMS — Solapi (문자 인증)
# https://console.solapi.com 에서 발급
# NODE_ENV=development 이면 실제 발송 안 함 (로그만 출력)
# ──────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# ──────────────────────────────────────
# CORS — 프론트엔드 URL
# 로컬 개발: 설정 안 해도 됨 (localhost:4200 기본 허용)
# 운영:      https://harmorise.app 같은 실제 도메인
# ──────────────────────────────────────
FRONTEND_URL=
