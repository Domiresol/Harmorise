# ──────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────
POSTGRES_USER=harmorise
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=harmorise_db
DATABASE_URL="postgresql://harmorise:harmorise1234@localhost:5432/harmorise_db"

# ──────────────────────────────────────
# Redis
# ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────
# Kafka (Redpanda)
# ──────────────────────────────────────
KAFKA_BROKERS=localhost:19092

# ──────────────────────────────────────
# NestJS
# ──────────────────────────────────────
PORT=3000
NODE_ENV=development
