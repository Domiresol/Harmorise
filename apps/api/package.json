{
  "name": "@harmorise/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          },
          "development-watch": {
            "args": [
              "--node-env=development",
              "--watch"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development-watch",
            "watch": true
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "db:cleanup-bpm": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx ts-node apps/api/prisma/cleanup-bpm-records.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma",
          "cwd": "{workspaceRoot}"
        }
      },
      "db:migrate:prod": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
          "cwd": "{workspaceRoot}"
        }
      },
      "db:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
          "cwd": "{workspaceRoot}"
        }
      },
      "db:seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma db seed --schema=apps/api/prisma/schema.prisma",
          "cwd": "{workspaceRoot}"
        }
      },
      "db:studio": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma studio --schema=apps/api/prisma/schema.prisma",
          "cwd": "{workspaceRoot}"
        }
      },
      "db:reset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate reset --schema=apps/api/prisma/schema.prisma --force",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^7.8.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2"
  }
}
